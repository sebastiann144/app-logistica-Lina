# Copia este archivo como `.env` y completa los valores con los de tu proyecto Firebase.
# Consola de Firebase -> Configuracion del proyecto -> Tus apps -> Configuracion del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_ADMIN_EMAIL=
VITE_EDITOR_EQUIPOS_EMAIL=
VITE_VISITANTE_MANT_EMAIL=
